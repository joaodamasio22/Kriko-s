<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>

    <entity name="Kriko\Entity\Pagamento" table="pagamentos">
        <id name="id" type="bigint">
            <generator strategy="AUTO" />
        </id>

        <field name="valor" type="decimal" precision="10" scale="2" column="valor" />
        <field name="metodo" type="string" column="metodo" />
        <field name="status" type="string" column="status" />
        <field name="data_criacao" type="datetime" column="data_criacao" />
        <field name="data_pagamento" type="datetime" column="data_pagamento" />
        <field name="referencia" type="string" column="referencia" length="255" />

        <many-to-one field="pedido" target-entity="Kriko\Entity\Pedido">
            <join-column name="pedido" referenced-column-name="id" />
        </many-to-one>

    </entity>
</doctrine-mapping>
