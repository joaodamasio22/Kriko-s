<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
            https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>

    <entity name="Kriko\Entity\Pagamento" table="pagamentos">
        <id name="id" type="bigint">
            <generator strategy="AUTO" />
        </id>

        <field name="valor" column="valor" type="integer" />
        <field name="metodo" column="metodo" type="string" />
        <field name="status" column="status" type="string" />
        <field name="data_criacao" column="data_criacao" type="datetime" />
        <field name="data_pagamento" column="data_pagamento" type="datetime" />
        <field name="referencia" column="referencia" type="string" length="255" />

        <many-to-one field="pedido" target-entity="Kriko\Entity\Pedido">
            <join-column name="pedido" referenced-column-name="id" />
        </many-to-one>

    </entity>
</doctrine-mapping>
