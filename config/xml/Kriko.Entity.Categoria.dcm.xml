<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
            https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>

    <entity name="Kriko\Entity\Categoria" table="categorias">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="nome" type="string" column="nome" length="50" />
        <field name="descricao" type="string" column="descricao" length="255" />

        <one-to-many field="produtos" target-entity="Kriko\Entity\Produto" mapped-by="categoria"/>
        
    </entity>
</doctrine-mapping>
