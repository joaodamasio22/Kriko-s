<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
            https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>

    <entity name="Kriko\Entity\Pedido" table="pedidos">

        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="data_pedido" column="data_pedido" type="datetime" />
        <field name="status" column="status" type="string" />
        <field name="forma_pagamento" column="forma_pagamento" type="string" length="20" nullable="true" />
        <field name="status_pagamento" column="status_pagamento" type="string" length="20" nullable="true" />
        <field name="valor_total" column="valor_total" type="integer" />
        <field name="observacao" column="observacao" type="text" nullable="true" />

        <many-to-one field="mesa" target-entity="Kriko\Entity\Mesa" inversed-by="pedidos">
            <join-column name="mesa" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <many-to-one field="admin" target-entity="Kriko\Entity\Administrador" inversed-by="pedidos">
            <join-column name="admin" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <one-to-many field="itens_pedido" target-entity="Kriko\Entity\ItemPedido" mapped-by="pedido" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="pagamentos" target-entity="Kriko\Entity\Pagamento" mapped-by="pedido"/>
    </entity>
</doctrine-mapping>
