<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
            https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>

    <entity name="Kriko\Entity\Produto" table="produtos">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>
        
        <field name="nome" column="nome" type="string" length="100" />
        <field name="descricao" column="descricao" type="text" />
        <field name="preco" column="preco" type="integer" />
        <field name="ativo" column="ativo" type="string" length="1" />

        <many-to-one field="categoria" target-entity="Kriko\Entity\Categoria">
            <join-column name="categoria" referenced-column-name="id" />
        </many-to-one>

    </entity>
</doctrine-mapping>
